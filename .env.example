# Copier ce fichier en .env (ignoré par git) pour surcharger les valeurs par défaut du poste de développement.
# Le même fichier est lu par docker-compose.yml et par l'application (spring.config.import) ;
# les variables d'environnement, si elles sont définies, gardent la priorité.
# Exemple : si le port 5432 est déjà pris sur le poste, mettre POSTGRES_PORT=5433.
POSTGRES_DB=groundedia
POSTGRES_USER=groundedia
POSTGRES_PASSWORD=groundedia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
