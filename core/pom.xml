<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.groundedia</groupId>
        <artifactId>groundedia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>groundedia-core</artifactId>
    <name>groundedIA :: core</name>
    <description>Le socle réutilisable : clients LLM et embeddings, ingestion, recherche, ancrage et citations</description>

    <!-- Bibliothèque : pas de classe main, pas de serveur embarqué (il vient de l'application). -->
    <dependencies>
        <!-- Composants Spring (@Service, @Repository), accès JDBC (JdbcClient) et transactions. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- HTTP dans les deux sens : RestClient pour appeler Ollama, annotations de l'endpoint REST /search. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- JSON (Jackson) pour les échanges avec Ollama et la réponse de /search. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Extraction du texte des PDF, page par page. Version non gérée par Spring Boot, donc épinglée ici.
             commons-logging est exclu : Spring fournit déjà cette API (spring-jcl) et la route vers Logback. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Tests unitaires : JUnit 5, AssertJ, Mockito, MockRestServiceServer (simulation d'Ollama). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
